---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('viet', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Viết">
  <h1>Viết</h1>
  <p class="byline" style="margin-bottom: 2rem;">Essay, tản văn, sáng tác — những gì đã có hình hài tương đối hoàn chỉnh.</p>
  <ul class="entry-list">
    {entries.map(entry => (
      <li>
        <a href={`/viet/${entry.id}/`}>{entry.data.title}</a>
        <div class="entry-meta">{entry.data.date.toLocaleDateString('vi-VN')}{entry.data.subtitle ? ` · ${entry.data.subtitle}` : ''}</div>
      </li>
    ))}
    {entries.length === 0 && <li style="border:none; color: var(--muted); font-family: var(--font-sans);">Chưa có bài nào ở đây.</li>}
  </ul>
</BaseLayout>
